# Copy to .env.local to override. VITE_* values end up in the browser bundle:
# never put a secret here.

# NEAR network for the wallet. Must match the backend's NEAR_RPC_URL (testnet by default).
VITE_NEAR_NETWORK=testnet

# Live events WebSocket. Empty = same origin through the Vite proxy (/api/ws).
# In production set the backend's address, e.g. wss://api.example.com/ws
# (Vercel rewrites do not proxy WebSockets, D37).
VITE_WS_URL=

# Optional contract overrides (defaults to the deployed testnet contracts):
# VITE_MARKETPLACE_CONTRACT_ID=marketplace.fondouk.testnet
# VITE_VAULT_CONTRACT_ID=vault.fondouk.testnet
# VITE_TEST_TOKEN_CONTRACT_ID=test_token.fondouk.testnet

