# Copy to .env and adjust. Never commit .env.

# Address the HTTP server listens on.
BIND_ADDR=127.0.0.1:8080

# Postgres connection (required). The user needs CREATEDB so `cargo test` can
# create temporary test databases.
DATABASE_URL=postgres://fondouk:CHANGE_ME@localhost:5432/fondouk

# Indexer: seconds between two DefiLlama fetch rounds (default 3600 = 1 hour, minimum 60).
INDEXER_INTERVAL_SECS=3600

# A village with no successful fetch for longer than this is "stale" and cannot
# receive funds. Default: 2 x INDEXER_INTERVAL_SECS. Must be longer than the interval.
# VILLAGE_STALE_AFTER_SECS=7200

# LLM provider (D17), OpenAI-compatible. Set all three or none; with none, the
# agent loop is off and the rest of the backend still runs. Never commit a key.
# Dev:  LLM_BASE_URL=https://openrouter.ai/api/v1
# Demo: LLM_BASE_URL=https://cloud-api.near.ai/v1
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-4o-mini

# Agent: seconds between two decision ticks (default 600 = 10 minutes, minimum 60).
# AGENT_TICK_SECS=600

# NEAR JSON-RPC used at login to check the signing key is a full-access key of
# the account (D38). Default: FastNEAR testnet (rpc.testnet.near.org is deprecated).
# NEAR_RPC_URL=https://test.rpc.fastnear.com

# Log level: error | warn | info | debug | trace (or per module, e.g. backend=debug)
RUST_LOG=info
