# Copy to .env and adjust. Never commit .env.

# Address the HTTP server listens on.
BIND_ADDR=127.0.0.1:8080

# Postgres connection (required). The user needs CREATEDB so `cargo test` can
# create temporary test databases.
DATABASE_URL=postgres://fondouk:CHANGE_ME@localhost:5432/fondouk

# Log level: error | warn | info | debug | trace (or per module, e.g. backend=debug)
RUST_LOG=info
