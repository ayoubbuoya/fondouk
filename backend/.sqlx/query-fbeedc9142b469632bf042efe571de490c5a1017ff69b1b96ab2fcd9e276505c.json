{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT m.avatar_id, a.name AS avatar_name, a.sprite, m.milestone, m.reached_at\n        FROM avatar_milestones m\n        JOIN avatars a ON a.id = m.avatar_id\n        ORDER BY m.reached_at DESC, m.milestone\n        LIMIT $1\n        ",
