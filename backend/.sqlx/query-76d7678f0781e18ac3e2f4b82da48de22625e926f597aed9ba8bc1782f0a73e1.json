  "query": "\n        SELECT DISTINCT ON (s.village_id)\n               s.village_id, s.ts, s.apy_base, s.apy_reward, s.tvl_usd\n        FROM yield_snapshots s\n        JOIN villages v ON v.id = s.village_id\n        WHERE v.active\n        ORDER BY s.village_id, s.ts DESC\n        ",
