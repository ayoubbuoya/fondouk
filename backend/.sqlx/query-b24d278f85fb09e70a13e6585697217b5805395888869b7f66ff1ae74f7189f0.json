{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT a.id, a.name, a.sprite, a.owner, a.price_yocto,\n               c.risk, c.goal\n        FROM avatars a\n        JOIN avatar_configs c ON c.id = a.config_id\n        WHERE a.listed = true AND a.cloned_from IS NULL\n        ORDER BY a.created_at ASC\n        ",
