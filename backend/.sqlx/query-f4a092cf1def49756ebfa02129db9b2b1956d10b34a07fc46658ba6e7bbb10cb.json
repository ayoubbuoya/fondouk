{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            m.id,\n            m.avatar_id,\n            a.name AS avatar_name,\n            a.sprite,\n            m.text,\n            m.ts\n        FROM arena_messages m\n        JOIN avatars a ON a.id = m.avatar_id\n        ORDER BY m.ts DESC\n        LIMIT $1\n        ",
