  "query": "\n        SELECT id, avatar_id, ts, source, input_hash, model, proposed_action, applied_action,\n               valid, rejected_rule, reason_public, cost_usd\n        FROM decisions\n        WHERE avatar_id = $1 AND source = $2\n        ORDER BY ts DESC, id DESC\n        LIMIT $3\n        ",
